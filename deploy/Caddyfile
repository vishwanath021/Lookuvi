# On-demand certificates for salon hostnames. A true wildcard (*.try.example)
# needs DNS-01 and a custom Caddy build. This file uses HTTP-01: one certificate
# per hostname, and only after GET /api/caddy/ask returns 200.
{
	on_demand_tls {
		ask http://app:3000/api/caddy/ask
	}
}

{$APP_DOMAIN}, www.{$APP_DOMAIN} {
	reverse_proxy app:3000 {
		# Overwrite, do not append. A browser-supplied X-Forwarded-For must not choose the rate-limit key.
		# The app then skips any private hop a later proxy appends and keeps this client address.
		header_up X-Forwarded-For {http.request.remote.host}
		header_up X-Real-IP {http.request.remote.host}
	}
}

*.try.{$ROOT_DOMAIN} {
	tls {
		on_demand
	}
	reverse_proxy app:3000 {
		header_up X-Forwarded-For {http.request.remote.host}
		header_up X-Real-IP {http.request.remote.host}
	}
}

# Verified custom domains. The ask endpoint refuses any host that is not on file.
https:// {
	tls {
		on_demand
	}
	reverse_proxy app:3000 {
		header_up X-Forwarded-For {http.request.remote.host}
		header_up X-Real-IP {http.request.remote.host}
	}
}
